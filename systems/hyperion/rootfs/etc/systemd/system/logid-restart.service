[Unit]
Description=Restart logid after a Logitech HID++ device appears
After=logid.service

[Service]
Type=oneshot
# Plain restart (not try-restart): this hook exists to recover logid, and
# try-restart is a no-op when the unit is inactive or start-limit-failed,
# which is exactly the state after a boot-time crash loop.
ExecStart=/usr/bin/sleep 1
ExecStart=/usr/bin/systemctl restart logid.service
