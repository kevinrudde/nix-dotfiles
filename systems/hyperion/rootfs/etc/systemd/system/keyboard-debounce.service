[Unit]
Description=Filter mechanical-switch chatter from the NuPhy keyboard
Documentation=file:///usr/local/bin/keyboard-debounce
After=systemd-udevd.service

[Service]
Type=simple
# 35 ms: measured chatter re-presses were 15-31 ms. 50 ms also ate presses
# at 35-45 ms that were likely genuine double letters or backspace taps.
# Over Bluetooth the board announces itself as "Air75 V3 ISO-1 Keyboard"
# without the vendor name, so match the model too.
ExecStart=/usr/local/bin/keyboard-debounce --match 'NuPhy|Air75' --threshold-ms 35
Restart=on-failure
RestartSec=2
Nice=-10
# Needs /dev/input/* (grab) and /dev/uinput; nothing else.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
DeviceAllow=char-input rw
DeviceAllow=/dev/uinput rw

[Install]
WantedBy=multi-user.target
