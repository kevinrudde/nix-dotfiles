// 1Password unlocks with system authentication (security.authenticatedUnlock),
// and its shipped policy -- /usr/share/polkit-1/actions/com.1password.1Password.policy
// -- declares auth_self for allow_active, so the vault asks for the user
// password even inside an already-authenticated session. Paired with
// security.autolock.onDeviceLock and hypridle suspending 15s after the lock
// lands, that means retyping the password after every screen lock.
//
// hyprlock already gates this session on the same PAM stack as login
// (/etc/pam.d/hyprlock includes login), so the second prompt re-proves what
// the unlock just proved. Returning YES for an active local session makes the
// system unlock the only password entry.
//
// Deliberately scoped to the unlock action alone. authorizeCLI and
// authorizeSshAgent stay at auth_self, so `op` reading a secret and the SSH
// agent signing a commit still cost a password -- those are the paths a
// script or a stray shell would take, and they are worth keeping expensive.
//
// The tradeoff this accepts: anything running in the active session can now
// open the vault UI without knowing a secret. The root filesystem is LUKS, so
// a powered-off machine is unaffected.
polkit.addRule(function (action, subject) {
  if (
    action.id === "com.1password.1Password.unlock" &&
    subject.user === "kevin" &&
    subject.local &&
    subject.active
  ) {
    return polkit.Result.YES;
  }
});
