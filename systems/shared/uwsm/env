DOTFILES_REPO_ROOT="${repo_root:-$HOME/.config/nix-dotfiles}"
DOTFILES_HOST="$(hostname -s 2>/dev/null || hostname)"
export DOTFILES_HOST_BIN="$DOTFILES_REPO_ROOT/systems/$DOTFILES_HOST/bin"

if [ -d "$DOTFILES_HOST_BIN" ]; then
  case ":$PATH:" in
    *":$DOTFILES_HOST_BIN:"*) ;;
    *) export PATH="$DOTFILES_HOST_BIN:$PATH" ;;
  esac
fi

nix_profile="$HOME/.nix-profile"
nix_state_profile="${XDG_STATE_HOME:-$HOME/.local/state}/nix/profile"

# Display-manager-launched sessions (SDDM, greetd, ...) don't source
# /etc/profile.d/nix.sh, so Nix-installed binaries (librepods, ...) are not
# on PATH unless we prepend them here. uwsm captures this env into the
# systemd user manager, so `uwsm app -- foo` inherits it.
for nix_bin_dir in "$nix_state_profile/bin" "$nix_profile/bin" "/nix/var/nix/profiles/default/bin"; do
  if [ -d "$nix_bin_dir" ]; then
    case ":$PATH:" in
      *":$nix_bin_dir:"*) ;;
      *) PATH="$nix_bin_dir:$PATH" ;;
    esac
  fi
done
export PATH
unset nix_bin_dir

export XDG_DATA_DIRS="$nix_state_profile/share:$nix_profile/share:/nix/var/nix/profiles/default/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# Greeters don't reliably export the passwd login shell; terminals spawn
# $SHELL, so derive it from the account database here.
login_shell="$(getent passwd "$(id -un)" | cut -d: -f7)"
if [ -n "$login_shell" ] && [ -x "$login_shell" ]; then
  export SHELL="$login_shell"
fi
unset login_shell

export XCURSOR_PATH="$HOME/.local/share/icons:$HOME/.icons:$nix_state_profile/share/icons:$nix_profile/share/icons:/nix/var/nix/profiles/default/share/icons:${XCURSOR_PATH:-/usr/share/icons}"

export MOZ_ENABLE_WAYLAND=1
export MOZ_USE_XINPUT2=1
export ELECTRON_OZONE_PLATFORM_HINT=auto
export SDL_VIDEODRIVER=wayland
export CLUTTER_BACKEND=wayland
export GTK_USE_PORTAL=1
export QT_QPA_PLATFORMTHEME=qt6ct
export QT_STYLE_OVERRIDE=kvantum
export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent"
